{
  "name": "sleepy-spinner",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "tsc -b --noEmit",
    "test": "vitest run",
    "db:up": "docker compose up -d --wait db && docker compose run --rm migrate up",
    "db:new": "docker compose run --rm migrate new",
    "db:reset": "docker compose down -v db && npm run db:up",
    "db:fixtures": "scripts/vocab-fixture.sh",
    "check": "ultracite check",
    "fix": "ultracite fix"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.116.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "oxfmt": "^0.70.0",
    "oxlint": "^1.85.0",
    "typescript": "^5.7.3",
    "ultracite": "^7.12.0",
    "vite": "^6.1.0",
    "vitest": "^3.0.5"
  }
}
