{
  "name": "sleepy-spinner",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "tsc -b --noEmit",
    "test": "vitest run",
    "db:up": "docker compose up -d --wait db && docker compose run --rm migrate up",
    "db:new": "docker compose run --rm migrate new",
    "db:reset": "docker compose down -v db && npm run db:up",
    "db:fixtures": "scripts/vocab-fixture.sh",
    "check": "ultracite check",
    "fix": "ultracite fix",
    "dev:api": "tsx watch --env-file=.env server/main.ts"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.3",
    "hono": "^4.13.13",
    "pg": "^8.23.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "esbuild": "^0.28.2",
    "oxfmt": "^0.70.0",
    "oxlint": "^1.85.0",
    "tsx": "^4.23.15",
    "typescript": "^5.7.3",
    "ultracite": "^7.12.0",
    "vite": "^6.1.0",
    "vitest": "^3.0.5"
  }
}
